# Local premium synthesis worker: the stand-in for the RTX PRO 6000 Cloud Run
# service. The backend sends it the takes of allowlisted users
# (SYNTHESIS_PREMIUM_ROUTING in dev.env). Sourced after dev.env and local.env
# by start_synthesis_worker_premium_dev.sh.
BACKEND_PORT=8004
# Its own data folder, as a separate Cloud Run service has its own disk.
BACKEND_DATA_DIR=data/synthesis-worker-premium
SYNTHESIS_WORKER_ENABLED=true
SYNTHESIS_DISPATCH_MODE=inline
PREPROCESS_DISPATCH_MODE=inline
# A worker renders the take itself; it never routes one to another worker.
SYNTHESIS_PREMIUM_ROUTING=off
MCP_GPU_ENABLED=true
MCP_START_ON_FIRST_CALL=false
SYNTHESIS_WORKER_TOKEN=local-dev-synthesis-worker
# One CPU MCP process, as in production.
MCP_CPU_WORKERS=1
# Two GPU processes, so two takes render at once (production runs four; each
# process loads its own models, so two keep a laptop's memory in bounds).
MCP_GPU_WORKERS=2
