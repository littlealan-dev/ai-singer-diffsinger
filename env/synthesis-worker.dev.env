# Local synthesis worker: the stand-in for the GPU Cloud Run service.
# Sourced after dev.env and local.env by start_synthesis_worker_dev.sh.
BACKEND_PORT=8003
BACKEND_DATA_DIR=data/synthesis-worker
SYNTHESIS_WORKER_ENABLED=true
SYNTHESIS_DISPATCH_MODE=inline
PREPROCESS_DISPATCH_MODE=inline
# A worker renders the take itself; it never routes one to another worker.
SYNTHESIS_PREMIUM_ROUTING=off
MCP_GPU_ENABLED=true
MCP_START_ON_FIRST_CALL=false
SYNTHESIS_WORKER_TOKEN=local-dev-synthesis-worker
# One CPU MCP process, as in production.
MCP_CPU_WORKERS=1
