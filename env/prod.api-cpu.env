# Overrides for the CPU-only, request-billed API. Merge after prod.env.
# Deploy only after synthesis is running on the GPU worker.
MCP_GPU_ENABLED=false
# Start the CPU MCP processes while the instance starts: the /readyz startup
# probe holds traffic (and keeps CPU allocated, with the startup boost) until
# they are ready, so no user's first tool call waits for them.
MCP_START_ON_FIRST_CALL=false
# Two CPU MCP processes (~250 MB each) on 2 vCPU, so concurrent users'
# score tools run side by side instead of queueing on one process.
MCP_CPU_WORKERS=2
SYNTHESIS_WORKER_ENABLED=false
SYNTHESIS_DISPATCH_MODE=cloud_tasks
SYNTHESIS_WORKER_URL=https://sightsinger-synthesis-worker-373752827978.us-east4.run.app
SYNTHESIS_WORKER_AUDIENCE=https://sightsinger-synthesis-worker-373752827978.us-east4.run.app
SYNTHESIS_WORKER_INVOKER_SERVICE_ACCOUNT=__PREPROCESS_WORKER_INVOKER_SERVICE_ACCOUNT__
SYNTHESIS_TASKS_QUEUE=projects/sightsinger-app/locations/us-east4/queues/synthesis-jobs
PREPROCESS_DISPATCH_MODE=cloud_tasks
SESSION_STORE=firestore
BACKEND_USE_STORAGE=true
BACKEND_EXPORT_MIX_ENABLED=false
