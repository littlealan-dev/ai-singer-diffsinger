# Local line-preparation worker: the stand-in for the CPU-only Cloud Run
# service that Cloud Tasks calls. Sourced after dev.env and local.env by
# scripts/start_preprocess_worker_dev.sh.
BACKEND_PORT=8002
# Its own data folder, as a separate Cloud Run service has its own disk: what
# it reads and writes must go through Firestore and Cloud Storage.
BACKEND_DATA_DIR=data/preprocess-worker
# No GPU on the worker service; only the CPU MCP worker runs.
MCP_GPU_ENABLED=false
PREPROCESS_WORKER_ENABLED=true
# The worker runs jobs; it never starts one itself.
PREPROCESS_DISPATCH_MODE=inline
# One CPU MCP process, as in production.
MCP_CPU_WORKERS=1
