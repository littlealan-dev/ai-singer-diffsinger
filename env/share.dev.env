# Local share service: public share links on their own slim service, as in production
# (src/backend/share_app.py). Sourced after dev.env and local.env by start_share_dev.sh.
# It reads the same Firestore and Storage emulators as the local API.
BACKEND_PORT=8005
BACKEND_DATA_DIR=data/share
BACKEND_APP_FACTORY=src.backend.share_app:create_share_app
