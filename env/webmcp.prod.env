# WebMCP challenge Cloud Run environment. This file contains configuration
# identifiers only; secret values remain in Google Secret Manager.
APP_ENV=prod
BACKEND_LOG_LEVEL=info
LOG_JSON=1

# Cloud Run L4 service settings are supplied by the deployment command.
OMP_NUM_THREADS=4
MKL_NUM_THREADS=4
OPENBLAS_NUM_THREADS=4
NUMEXPR_NUM_THREADS=4
ORT_INTRA_OP_NUM_THREADS=2
ORT_INTER_OP_NUM_THREADS=2
MCP_GPU_DEVICE=cuda
MCP_STARTUP_TIMEOUT_SECONDS=120
BACKEND_READY_TIMEOUT_SECONDS=240
MCP_STARTUP_BLOCKING=false
MCP_GPU_TIMEOUT_SECONDS=1200

# Reviewer access still requires a valid Firebase ID token. The challenge
# frontend does not configure Firebase App Check, so do not enforce it here.
BACKEND_AUTH_DISABLED=false
BACKEND_REQUIRE_APP_CHECK=false
BACKEND_USE_STORAGE=true
CORS_ALLOW_ORIGINS=https://sightsinger-webmcp.web.app,https://sightsinger-webmcp.firebaseapp.com

PROJECT_ID=sightsinger-app
STORAGE_BUCKET=sightsinger-app.firebasestorage.app
VOICEBANK_BUCKET=sightsinger-app.firebasestorage.app
VOICEBANK_PREFIX=assets/voicebanks
BACKEND_MAX_UPLOAD_MB=5
BACKEND_MAX_MXL_UNCOMPRESSED_MB=20
SYNTHESIS_MAX_DURATION_SECONDS=300
VOICEBANK_LARGE_DICT_THRESHOLD_BYTES=5000000

# Only the LIEE voicebank is enabled by the production challenge manifest.
BACKEND_DEFAULT_VOICEBANK="Diffsinger LIEE Immortal Idol (JubiLIEE 2025)"

# Challenge credit allowance. Billing, Stripe, Brevo, and marketing settings
# intentionally remain absent from this environment.
FREE_TIER_MONTHLY_ALLOWANCE=100
CREDIT_RETRY_MAX_ATTEMPTS=3
CREDIT_RETRY_BASE_DELAY_SECONDS=0.5
CREDIT_RETRY_TEST_SETTLE_FAIL_COUNT=0
CREDIT_RETRY_TEST_RELEASE_FAIL_COUNT=0
MARKETING_DOI_RECONCILE_ENABLED=false

# The Gemini key is fetched at runtime from this challenge-only Secret Manager
# secret by the dedicated Cloud Run service account.
LLM_PROVIDER=gemini
GEMINI_API_KEY_SECRET=gemini-api-key-webmcp
GEMINI_API_KEY_SECRET_VERSION=latest
GEMINI_DEFAULT_MODEL=gemini-3.1-flash-lite
GEMINI_DEFAULT_THINKING_LEVEL=low
GEMINI_DEFAULT_TIMEOUT_SECONDS=180
GEMINI_PREPROCESS_MODEL=gemini-3-flash-preview
GEMINI_PREPROCESS_THINKING_LEVEL=
GEMINI_PREPROCESS_TIMEOUT_SECONDS=180
GEMINI_INCLUDE_THOUGHT_SUMMARY=1
GEMINI_PROMPT_CACHE_ENABLED=true
GEMINI_PROMPT_CACHE_TTL_DAYS=30
GEMINI_PROMPT_CACHE_DELETE_STALE=false

# Generated audio URLs use the existing dedicated playback-token secret.
BACKEND_PLAYBACK_TOKEN_SECRET=BACKEND_PLAYBACK_TOKEN_SECRET
BACKEND_PLAYBACK_TOKEN_SECRET_VERSION=latest
BACKEND_PLAYBACK_TOKEN_TTL_SECONDS=300

VOICE_PART_MIN_WORD_LYRIC_COVERAGE_RATIO=0.15
VOICE_PART_MIN_WORD_LYRIC_WARN_FLOOR_RATIO=0.75
VOICE_PART_WEAK_LYRIC_SOURCE_MAX_WORD_RATIO=0.35
VOICE_PART_WEAK_LYRIC_SOURCE_MIN_RATIO_DELTA=0.25
VOICE_PART_WEAK_LYRIC_SOURCE_MIN_WORD_DELTA=2
VOICE_PART_CROSS_STAFF_LOCAL_MIN_WORD_RATIO=0.6
VOICE_PART_CROSS_STAFF_LOCAL_MIN_RATIO_DELTA=0.35
VOICE_PART_CROSS_STAFF_LOCAL_MIN_WORD_DELTA=3
VOICE_PART_CROSS_STAFF_DONOR_MIN_WORD_RATIO=0.6
VOICE_PART_CROSS_STAFF_DONOR_MIN_RATIO_DELTA=0.3
VOICE_PART_CROSS_STAFF_DONOR_MIN_WORD_DELTA=3
VOICE_PART_REPAIR_MAX_RETRIES=2
SYLLABLE_ALIGNER_V2=1
SYLLABLE_TIMING_V2=1
INJECT_FULL_PARSED_SCORE_JSON=0
PREPROCESS_MAX_ATTEMPTS=3
PREPROCESS_INITIAL_PLAN_LLM_MAX_RESPONSES=3
