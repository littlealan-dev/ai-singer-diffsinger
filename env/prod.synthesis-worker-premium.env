# The premium synthesis worker (RTX PRO 6000, us-central1), applied on top of
# prod.env and prod.synthesis-worker.env by deploy_synthesis_worker_premium_prod.sh.
# Four GPU processes, so four takes render at once; each may keep four voices
# loaded (96 GB of GPU memory against about 1 GiB per voice on the L4).
MCP_GPU_WORKERS=4
SYNTHESIS_MAX_LOADED_VOICES=4
