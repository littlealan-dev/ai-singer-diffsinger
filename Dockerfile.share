# The share service (src/backend/share_app.py): public share links on their own slim image,
# without the API's MCP, LLM and phonemizer code, so a cold start takes seconds.
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8080 \
    PYTHONPATH=/app

WORKDIR /app

COPY requirements-share.txt /app/requirements-share.txt
RUN python3 -m pip install --no-cache-dir --upgrade pip && \
    python3 -m pip install --no-cache-dir -r /app/requirements-share.txt

COPY src /app/src

CMD ["python3", "-m", "uvicorn", "--factory", "src.backend.share_app:create_share_app", "--host", "0.0.0.0", "--port", "8080", "--log-level", "info", "--access-log"]
